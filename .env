# --- ERPNext Hybrid Dev Environment Variables ---
# You can change these safely, then re-run the scripts.

# Choose Frappe/ERPNext version branches. Common: version-15 or version-16
FRAPPE_BRANCH=version-15
ERPNEXT_BRANCH=version-15

# Site/domain you'll develop on (also add to /etc/hosts later)
SITE_NAME=erp.local

# Admin password for the new site
ADMIN_PASSWORD=admin

# Database root password (for the MariaDB container)
DB_ROOT_PASSWORD=frappe

# Host/ports to connect from your host bench to Docker services
DB_HOST=127.0.0.1
DB_PORT=3307

REDIS_CACHE=redis://127.0.0.1:6379
REDIS_QUEUE=redis://127.0.0.1:6380
REDIS_SOCKETIO=redis://127.0.0.1:6381

# Runtime toolchain versions
# Python version used by bench's virtualenv (installed via pyenv)
PYTHON_VERSION=3.11.9
# Node major used for building assets; 18 is safe for v15; use 20 for v16
NODE_MAJOR=18

